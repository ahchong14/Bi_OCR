{
  "name": "receipt-portal-autocount",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"bun --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test server/tests",
    "reset": "bun scripts/reset.ts",
    "eval": "bun eval/report.ts",
    "eval:export": "bun eval/export-golden.ts",
    "eval:run": "bun eval/run-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "8",
    "elysia": "^1.4.30",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
