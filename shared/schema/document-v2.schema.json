{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-v2.schema.json",
  "title": "PublicDocumentV2",
  "description": "Response body of GET /v2/receipts/{id} and the `receipt` member of POST /v2/scan. Unknown values are null, never invented. Text taken from the image (title, keywords, party names, descriptions) is untrusted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "file", "classification", "title", "keywords", "language", "header", "parties", "amounts", "taxes",
    "line_items", "payment", "relations", "autocount_hint", "reconciliation", "quality", "review", "untrusted_text_fields", "warnings"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["2.0"] },
    "id": { "type": "integer", "minimum": 1 },
    "file": { "type": "string", "maxLength": 200 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "autocount_doc_type", "direction", "confidence", "alternatives", "evidence", "title_printed", "type_verdict"],
      "properties": {
        "document_type": { "enum": ["receipt", "invoice", "sales_invoice", "purchase_invoice", "sales_order", "quotation", "delivery_order", "credit_note", "other", null] },
        "autocount_doc_type": { "type": ["string", "null"], "maxLength": 8 },
        "direction": { "enum": ["sales", "purchase", "unknown"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "alternatives": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/alternative" } },
        "evidence": { "type": "array", "maxItems": 5, "items": { "type": "string", "maxLength": 120 } },
        "title_printed": { "type": ["string", "null"], "maxLength": 60 },
        "type_verdict": { "enum": ["ok", "low_confidence", "direction_unknown", "evidence_missing", "conflict", "unverified", "unclassified"] }
      }
    },
    "title": { "type": ["string", "null"], "maxLength": 80 },
    "keywords": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 40 } },
    "language": { "enum": ["en", "ms", "zh", "mixed", null] },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_no", "doc_date", "due_date", "valid_until", "currency", "reference", "customer_po_no", "terms", "supplier_invoice_no", "delivery_address"],
      "properties": {
        "doc_no": { "type": ["string", "null"], "maxLength": 40 },
        "doc_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "due_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "valid_until": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "currency": { "type": ["string", "null"], "maxLength": 8 },
        "reference": { "type": ["string", "null"], "maxLength": 20 },
        "customer_po_no": { "type": ["string", "null"], "maxLength": 40 },
        "terms": { "type": ["string", "null"], "maxLength": 60 },
        "supplier_invoice_no": { "type": ["string", "null"], "maxLength": 40 },
        "delivery_address": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "parties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "counterparty"],
      "properties": {
        "issuer": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/party" }] },
        "counterparty": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/party" }] }
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtotal", "discount", "service_charge", "tax", "tip", "fees", "rounding", "total", "paid", "change", "outstanding"],
      "properties": {
        "subtotal": { "type": ["number", "null"] },
        "discount": { "type": ["number", "null"] },
        "service_charge": { "type": ["number", "null"] },
        "tax": { "type": ["number", "null"] },
        "tip": { "type": ["number", "null"] },
        "fees": { "type": ["number", "null"] },
        "rounding": { "type": ["number", "null"] },
        "total": { "type": ["number", "null"] },
        "paid": { "type": ["number", "null"] },
        "change": { "type": ["number", "null"] },
        "outstanding": { "type": ["number", "null"] }
      }
    },
    "taxes": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/tax" } },
    "line_items": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/item" } },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reference", "card_last4"],
      "properties": {
        "method": { "enum": ["cash", "card", "bank_transfer", "ewallet", "cheque", "credit", "unknown", null] },
        "reference": { "type": ["string", "null"], "maxLength": 60 },
        "card_last4": { "type": ["string", "null"], "pattern": "^\\d{4}$" }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_invoice_no", "related_po_no", "related_so_no", "related_do_no", "reason"],
      "properties": {
        "original_invoice_no": { "type": ["string", "null"], "maxLength": 40 },
        "related_po_no": { "type": ["string", "null"], "maxLength": 40 },
        "related_so_no": { "type": ["string", "null"], "maxLength": 40 },
        "related_do_no": { "type": ["string", "null"], "maxLength": 40 },
        "reason": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "autocount_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "party_role", "party_name_as_printed", "needs_master_match", "post_as"],
      "properties": {
        "entity": { "type": ["string", "null"] },
        "party_role": { "enum": ["debtor", "creditor", null] },
        "party_name_as_printed": { "type": ["string", "null"], "maxLength": 200 },
        "needs_master_match": { "type": "boolean" },
        "post_as": { "enum": ["document", "cash_book_voucher", "none"] }
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "has_failure", "checks", "suggestions", "flags"],
      "properties": {
        "mode": { "enum": ["exclusive", "inclusive", "unknown"] },
        "has_failure": { "type": "boolean" },
        "checks": { "type": "array", "items": { "type": "object", "required": ["id", "status"], "properties": { "id": { "type": "string" }, "status": { "enum": ["ok", "warn", "fail", "info"] } } } },
        "suggestions": { "type": "array", "items": { "type": "object" } },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "type_verdict", "needs_review", "reasons", "needs_review_reasons"],
      "properties": {
        "verdict": { "enum": ["REVIEW", "PARTIAL", "CORRECTED", "AUTO_VERIFIED", "AUTO"] },
        "type_verdict": { "enum": ["ok", "low_confidence", "direction_unknown", "evidence_missing", "conflict", "unverified", "unclassified"] },
        "needs_review": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "needs_review_reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewed_by", "reviewed_at", "human_edited_fields"],
      "properties": {
        "state": { "enum": ["pending", "approved", "rejected"] },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"] },
        "human_edited_fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "untrusted_text_fields": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "confidence"],
      "properties": {
        "document_type": { "enum": ["receipt", "invoice", "sales_invoice", "purchase_invoice", "sales_order", "quotation", "delivery_order", "credit_note", "other"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_as_printed", "name_normalized", "reg_no", "tax_id", "address", "phone", "email"],
      "properties": {
        "name_as_printed": { "type": ["string", "null"], "maxLength": 200 },
        "name_normalized": { "type": ["string", "null"], "maxLength": 200 },
        "reg_no": { "type": ["string", "null"], "maxLength": 40 },
        "tax_id": { "type": ["string", "null"], "maxLength": 40 },
        "address": { "type": ["string", "null"], "maxLength": 300 },
        "phone": { "type": ["string", "null"], "maxLength": 40 },
        "email": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate", "base", "amount"],
      "properties": {
        "label": { "type": ["string", "null"] },
        "rate": { "type": ["number", "null"] },
        "base": { "type": ["number", "null"] },
        "amount": { "type": ["number", "null"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_no", "description", "item_code_printed", "quantity", "uom", "unit_price", "discount", "tax_rate", "total_price"],
      "properties": {
        "line_no": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "item_code_printed": { "type": ["string", "null"] },
        "quantity": { "type": ["number", "null"] },
        "uom": { "type": ["string", "null"] },
        "unit_price": { "type": ["number", "null"] },
        "discount": { "type": ["number", "null"] },
        "tax_rate": { "type": ["number", "null"] },
        "total_price": { "type": ["number", "null"] }
      }
    }
  }
}
